{
  "name": "@stackline/react-highcharts",
  "version": "19.1.0",
  "description": "A maintained React 19 wrapper for Highcharts, Highstock, and Highmaps with native options, constructor switching, module helpers, refs, and realtime update modes.",
  "keywords": [
    "react",
    "react-library",
    "typescript",
    "highcharts",
    "charts",
    "react-highcharts",
    "highcharts-react",
    "highcharts-wrapper",
    "react-charts",
    "highstock",
    "highmaps",
    "stock-chart",
    "candlestick",
    "realtime-charts",
    "dynamic-charts",
    "heatmap",
    "treemap",
    "3d-chart",
    "chart-wrapper",
    "wrapper",
    "ui-component",
    "maintained"
  ],
  "homepage": "https://alexandro.net/docs/react/react-highcharts/",
  "bugs": {
    "url": "https://github.com/alexandroit/react-highcharts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/react-highcharts.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist docs/react-17 docs/react-18 docs/react-19",
    "docs:install:react-17": "cd docs-src/react-17 && npm install",
    "docs:install:react-18": "cd docs-src/react-18 && npm install",
    "docs:install:react-19": "cd docs-src/react-19 && npm ci",
    "build:docs:react-17": "cd docs-src/react-17 && npm run build",
    "build:docs:react-18": "cd docs-src/react-18 && npm run build",
    "build:docs:react-19": "cd docs-src/react-19 && npm run build",
    "build:docs": "npm run build:docs:react-19",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:browser": "node scripts/verify-react-19-docs.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "highcharts": ">=6.0.0 <=13.0.1",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "highcharts": "13.0.1",
    "jsdom": "30.0.1",
    "puppeteer-core": "25.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
